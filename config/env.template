# ── Active LLM selection ─────────────────────────────────────────────
# PROVIDER selects which API_BASE + API_KEY are used at runtime.
# Valid values: google | nvidia | custom
# MODEL must be a model ID supported by the chosen provider.
PROVIDER=google
MODEL=gemini-3.5-flash

# Optional: reasoning effort for thinking models (minimal|low|medium|high).
# Defaults to "high" (set in hellotalk-llm-call.py). Google's OpenAI-compatible
# endpoint maps this natively to a thinking budget.
#REASONING_EFFORT=medium

# NOTE: MAX_TOKENS is intentionally NOT set here. Thinking models draw their
# reasoning tokens from the same budget, so a small MAX_TOKENS (e.g. 16384)
# can be consumed entirely by reasoning and produce zero output. Each script
# picks a safe default (131072 for analyze/drill; 32768 fallback in
# hellotalk-llm-call.py). Only set this if you know your model's behavior.
#MAX_TOKENS=131072

# ── Provider: Google AI Studio (OpenAI-compatible endpoint) ──────────
# Models: gemini-3.5-flash, gemini-3.5-pro, ...
#GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Provider: NVIDIA NIM (OpenAI-compatible) ─────────────────────────
# Models: moonshotai/kimi-k2.5, qwen/qwen3.5-397b-a17b, deepseek-ai/deepseek-v4-pro, ...
#NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Provider: Custom (any OpenAI-compatible endpoint) ────────────────
# Set PROVIDER=custom and configure both values. Examples:
#   CUSTOM_API_BASE=https://api.openai.com/v1
#   CUSTOM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CUSTOM_API_BASE=
CUSTOM_API_KEY=

# ── Multi-model variant generation ───────────────────────────────────
# When VARIANTS=1, each artifact (grammar.md, semantic.md, the Anki decks,
# the drill sessions) is generated twice by two independently configured
# models, then a third call reconciles the two candidates into the final
# file using prompts/judge-analysis.md, judge-tsv.md or judge-drill.md.
#
# Two models miss different things, so the union of what they found is
# better than either alone — that is what the reconciliation step keeps.
#
# This costs three API calls per artifact instead of one. Leave it at 0
# for the automated systemd runs and turn it on per-invocation when you
# want the better output:  VARIANTS=1 hellotalk-generate-anki.sh
VARIANTS=0

# Which slots take part, in order. The first usable slot is the fallback
# whenever reconciliation cannot run. Quote the value — this file is also
# sourced by bash.
VARIANT_SLOTS="PRIMARY SECONDARY"

# Each slot reads <SLOT>_PROVIDER, _MODEL, _API_BASE, _API_KEY,
# _REASONING_EFFORT and _MAX_TOKENS. Only the FIRST slot falls back to the
# PROVIDER / MODEL / REASONING_EFFORT set above, so leaving PRIMARY blank
# reproduces the ordinary single-model setup. Every later slot must name its
# own model: two candidates from one model share their blind spots, so the
# runner skips a duplicate slot instead of paying for it.
#PRIMARY_PROVIDER=google
#PRIMARY_MODEL=gemini-3.5-flash

#SECONDARY_PROVIDER=nvidia
#SECONDARY_MODEL=moonshotai/kimi-k2.5
# A slot's model may cap output lower than MAX_TOKENS (a gateway in front of
# SenseNova rejects anything over 65536 with a 400). Name that slot's budget
# here rather than lowering MAX_TOKENS for every model.
#SECONDARY_MAX_TOKENS=65536

# Which model reconciles the candidates. Defaults to the first usable slot.
#JUDGE_PROVIDER=google
#JUDGE_MODEL=gemini-3.5-pro

# Keep the raw candidates next to the finished file, under variants/.
# Set to 0 to delete them once reconciliation succeeds.
VARIANT_KEEP=1

# A reconciled file is rejected if it retains less than this percent of the
# richest candidate's entry/card/topic count, and the best structurally valid
# candidate is used instead. Guards against a judge that truncates or returns
# a near-empty result over a complete candidate.
#VARIANT_MIN_UNIT_PCT=50
