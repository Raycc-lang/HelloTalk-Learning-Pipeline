[Unit]
Description=Cleanse HelloTalk transcripts (remove noise, artifacts, private content)
After=hellotalk-transcribe.service
# Analyze is decoupled: it runs on its own nightly timer (02:30) when the
# custom provider is smooth. Cleanse can run any time without triggering
# a daytime LLM call.

[Service]
Type=oneshot
ExecStart=%h/.local/bin/hellotalk-cleanse.sh
Environment=HOME=%h
TimeoutStartSec=7200

[Install]
WantedBy=default.target
